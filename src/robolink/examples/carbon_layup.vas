# V-Alpha Script — carbon fiber composite layup
# CR5 arm, 2-pass raster pattern
# Mirrors real layup trials at NUST Pakistan (2023-2024)

MOVJ(HOME)
WAIT(1.0)
SPEED(0.7)

# Pass 1 — sweep shoulder joint forward
MOVJ(0, -0.8, 0.5, 0, 1.5, 0)
MOVJ(0, -0.6, 0.5, 0, 1.5, 0)
MOVJ(0, -0.4, 0.5, 0, 1.5, 0)
MOVJ(0, -0.2, 0.5, 0, 1.5, 0)

# Pass 2 — shift base joint, sweep back
MOVJ(0.2, -0.2, 0.5, 0, 1.5, 0)
MOVJ(0.2, -0.4, 0.5, 0, 1.5, 0)
MOVJ(0.2, -0.6, 0.5, 0, 1.5, 0)
MOVJ(0.2, -0.8, 0.5, 0, 1.5, 0)

SPEED(1.0)
MOVJ(HOME)